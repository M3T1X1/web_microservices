DATABASE_URL=sqlite:///./inventory.db
OUTBOUND_DATABASE_URL=sqlite:///./outbound.db
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_PREFIX=lab2:131427:warehouse
CACHE_TTL_SECONDS=60
# LAB4: port Uvicorna musi odpowiadać SERVICE_PORT (8101 Inventory / 8102 Outbound).
EUREKA_SERVER_URL=http://127.0.0.1:8761
GATEWAY_EUREKA_URL=http://127.0.0.1:8761/eureka/
GATEWAY_PORT=8080
EUREKA_PORT=8761

# Shipping i Auth; konfiguracja wspólna dla lokalnego uruchomienia.
SHIPPING_DATABASE_URL=sqlite:///./shipping.db
AUTH_DATABASE_URL=sqlite:///./auth.db
JWT_PUBLIC_KEY_FILE=.local/jwt-public.pem
# Klucz prywatny należy udostępnić wyłącznie procesowi Auth.
JWT_PRIVATE_KEY_FILE=.local/jwt-private.pem
JWT_ISSUER=warehouse-auth
JWT_AUDIENCE=warehouse-api
JWT_TTL_SECONDS=900
