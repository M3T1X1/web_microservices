# Przykład; aplikacja nie wczytuje automatycznie pliku .env.
# Ustaw zmienne w terminalu zgodnie z README przed startem Uvicorna.
DATABASE_URL=sqlite:///./inventory.db
OUTBOUND_DATABASE_URL=sqlite:///./outbound.db
REDIS_URL=redis://127.0.0.1:6379/0
# Zastąp UZUPELNIJ własnym numerem albumu.
CACHE_PREFIX=lab2:UZUPELNIJ:warehouse
CACHE_TTL_SECONDS=60
